# Xcode project is generated by XcodeGen from project.yml — never commit it.
EVE.xcodeproj/

# Info.plist is generated by XcodeGen (see project.yml `info:`) — never commit it.
EVE/Resources/Info.plist

# Per-deployment EVE root CA (see EVE/Resources/EVERootCA-README.md) — CI
# writes this from the EVE_ROOT_CA_PEM secret at build time; never commit
# a real one, since there is no single "the" EVE root CA.
EVE/Resources/EVERootCA.cer

# Build products
.build/
DerivedData/
build/

# Xcode user state
xcuserdata/
*.xcuserstate
.swiftpm/

# macOS
.DS_Store

# fastlane (docs/testflight.md) — logs and local reports, never the API key
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/
fastlane/test_output/
vendor/bundle/
.bundle/

